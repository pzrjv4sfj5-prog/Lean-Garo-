  "hard_rules":[
    "Master Dictionary noun lookup always happens before classifier selection.",
    "Never invent a Garo noun from a classifier category.",
    "Classifier selection must not replace the noun returned by the Master Dictionary.",
    "Keep classifier/counting unit and number separate in machine representation.",
    "Use the pushed number table as the number source.",
    "Do not create new teen or tens vocabulary when additive composition is defined.",
    "Do not use rongs; the approved classifier is rong.",
    "rong is not restricted to fruit; current approved uses include fruit, water/drink container counting, alcohol, beer, and egg.",
    "Alcohol is explicitly included in the classifier mapping.",
    "The confirmed water counting output is Chi rong sa.",
    "Banana and banana bunch are explicit exceptions and must be checked before general fruit -> rong.",
    "Do not silently import older inconsistent counted examples from legacy dictionary documents.",
    "Do not silently change lexical spellings or adjudicate unresolved linguistic conflicts inside Claude B runtime work."
  ],
  "agent_contracts":{
    "claude_a":"Use this file for linguistic/category/classifier review. Validate noun mappings against the Master Dictionary and Owner-confirmed evidence. Do not invent nouns. Flag unresolved linguistic candidates instead of silently choosing them. Any linguistic correction must be explicit and provenance-aware.",
    "claude_b":"Use this file as the runtime integration contract. Consume the number source by path, implement deterministic noun -> category -> exception -> classifier/unit -> number -> surface processing, preserve internal separation of classifier/unit and number, and provide source-to-runtime trace for changes. Do not adjudicate linguistic conflicts or invent lexical forms.",
    "shared_rule":"A owns linguistic content/classifier adjudication; B owns implementation/runtime. Neither agent may silently rewrite the other's source of truth."
  },
  "validation_expectations":[
    "JSON must parse successfully.",
    "All classifier records must have category, subcategory, marker_type, classifier_or_unit, and counting_logic.",
    "Number source path must resolve to data/garo_number_system_machine_ready.json.",
    "No hyphens in number vocabulary in this file.",
    "No accidental unrelated classifier vocabulary is included.",
    "Known confirmed examples must remain exact where specified.",
    "No invented Master Dictionary nouns are permitted."
  ]
