{
  "schema": "lean-garo.number_classifier_engine.v1",
  "title": "Lean-Garo Number + Classifier Engine — Machine Ready",
  "purpose": "Single source-of-truth interface for Claude A linguistic/category review and Claude B runtime integration. Resolve English noun to Master Dictionary Garo noun first, then category/subcategory, classifier or counting unit, quantity, pushed number table, and approved surface realization.",
  "scope": "Number + classifier/counting-marker logic only.",
  "authority": {
    "noun_lexicon": "Master Dictionary is authoritative for Garo noun lookup; classifier logic must never invent or replace a noun.",
    "number_source": "data/garo_number_system_machine_ready.json",
    "owner_corrections": "Current Project Owner-confirmed corrections in this specification override older inconsistent counted examples.",
    "orthography": "Preserve established project spellings. No hyphens in number displays. Keep classifier and number as separate internal fields."
  },
  "engine_pipeline": [
    "english_noun_or_quantity_expression",
    "master_dictionary_lookup",
    "garo_noun",
    "category",
    "subcategory",
    "exception_check",
    "classifier_or_counting_unit",
    "numeric_quantity",
    "number_engine_lookup",
    "surface_realization",
    "final_counted_expression"
  ],
  "core_formula": "ENGLISH NOUN -> MASTER DICTIONARY GARO NOUN -> CATEGORY -> SUBCATEGORY -> EXCEPTION CHECK -> CLASSIFIER/UNIT -> NUMBER ENGINE -> SURFACE RULE -> FINAL PHRASE",
  "machine_record_fields": ["english_noun", "garo_noun", "category", "subcategory", "marker_type", "classifier_or_unit", "quantity", "garo_number", "surface_rule", "status", "notes"],
  "marker_types": ["classifier", "measurement_unit", "serving_unit", "counting_marker"],
  "surface_policy": {
    "internal_representation": "classifier_or_unit and garo_number are always separate fields",
    "default_display": "NOUN + SPACE + CLASSIFIER_OR_UNIT + SPACE + GARO_NUMBER",
    "exception": "A classifier-specific fused surface may be applied only when explicitly approved; do not encode fusion into the number engine.",
    "human_40_plus": "Owner-confirmed human examples include Chattro saksotbri and Chattro saksotbri sa; preserve this as a surface realization rule rather than changing the independent number table."
  },
