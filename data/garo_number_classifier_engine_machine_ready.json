{
  "schema": "lean-garo.number_classifier_engine.v2",
  "title": "Lean-Garo Number + Classifier Engine — Machine Ready",
  "purpose": "Single source-of-truth interface for Claude A linguistic/category review and Claude B runtime integration. Resolve English noun to Master Dictionary Garo noun first, then category/subcategory, classifier or counting unit, quantity, number-engine value, and approved surface realization.",
  "scope": "Number + classifier/counting-marker logic only.",
  "authority": {
    "noun_lexicon": "Master Dictionary is authoritative for Garo noun lookup; classifier logic must never invent or replace a noun.",
    "number_source": "data/garo_number_system_machine_ready.json",
    "owner_corrections": "Current Project Owner-confirmed corrections and current Claude A linguistic corrections override older inconsistent counted examples.",
    "orthography": "Preserve established project spellings. No hyphens in number displays. Keep classifier and number as separate internal fields."
  },
  "engine_pipeline": [
    "english_noun_or_quantity_expression",
    "master_dictionary_lookup",
    "garo_noun",
    "category",
    "subcategory",
    "exception_check",
    "classifier_or_counting_unit",
    "numeric_quantity",
    "number_engine_lookup",
    "surface_realization",
    "final_counted_expression"
  ],
  "core_formula": "ENGLISH NOUN -> MASTER DICTIONARY GARO NOUN -> CATEGORY -> SUBCATEGORY -> EXCEPTION CHECK -> CLASSIFIER/UNIT -> NUMBER ENGINE -> SURFACE RULE -> FINAL PHRASE",
  "machine_record_fields": [
    "english_noun",
    "garo_noun",
    "category",
    "subcategory",
    "marker_type",
    "classifier_or_unit",
    "quantity",
    "garo_number",
    "surface_rule",
    "status",
    "notes"
  ],
  "marker_types": [
    "classifier",
    "measurement_unit",
    "serving_unit",
    "counting_marker"
  ],
  "surface_policy": {
    "internal_representation": "classifier_or_unit and garo_number are always separate fields",
    "default_display": "NOUN + CLASSIFIER_OR_UNIT + GARO_NUMBER, fused with no space and no raka dot, for the majority of classifiers (sak/rong/pang/dot/dam/dil/bol). CORRECTED 2026-09-12 (Claude A): this contract originally stated a SPACED default; that was a draft assumption written before the 2026-08-13 direct Thangseng citations for mountain/village/road/car came in, which are explicitly fused. The raka-dot classifiers (mang/ge/gong/te/king) are a separate, smaller set — see RULE-038.yaml / RAKA_CLASSIFIERS in src/garo_classifier.js.",
    "exception": "Genuinely spaced surfaces exist too (e.g. the tens+remainder space in 'Chattro saksotbonga bonga'), but there is currently no citation confirming plain-space noun-classifier-number order for any classifier in this table — 'Chi rong sa' / 'beer rong sa' below are UNCONFIRMED (no master_dictionary.json row backs them; likely the same stale-draft assumption as mountain/village/road/car). Needs native confirmation, not yet corrected.",
    "human_40_plus": "Owner-confirmed human examples include Chattro saksotbri and Chattro saksotbri sa; preserve this as a surface realization rule rather than changing the independent number table.",
    "human_70_plus": "Thangseng-confirmed 2026-09-12 (NV-157): the same fused sak+tens surface pattern generalizes past 60 with no change — e.g. 71 = Chattro saksotsni sa. Applies uniformly through the 70s/80s/90s using Sotsni/Sotchet/Sotsku."
  },
