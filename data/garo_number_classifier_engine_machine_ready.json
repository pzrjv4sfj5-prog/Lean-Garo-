    "rules": {
      "1_10": "established base numbers",
      "11_19": "explicit Chi· + base digit entries; do not regenerate as Chiking + unit",
      "21_99": "tens SPACE unit",
      "100_999": "Ritcha + hundred multiplier; remainder follows by SPACE",
      "1000_9999": "Hajalsa with multiplier and remainder by SPACE",
      "10000": "Hajalchikking",
      "100000": "Lakhsa"
    },
    "base_numbers": {
